# /opt/stacks/learnharness-ts/.env (chmod 600). Placeholders only.
# Compose reads this file for ${...} in compose.yml; only the tailscale
# service gets these values.

# One-time Tailscale auth key for the sidecar (admin console -> Settings ->
# Keys -> Generate auth key: not reusable, not ephemeral). Delete this line
# after the first successful start: the node key is then in the ts-state volume.
TS_AUTHKEY=tskey-auth-REPLACE_ME
# Machine name on the tailnet; the URL becomes https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=learnharness
