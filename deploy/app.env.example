# <stack folder>/app.env, next to compose.yml (chmod 600 on Linux/macOS).
# Placeholders only.
# Only the app container gets these values.
LH_SERVER_MODE=remote
# Your Tailscale login name(s), comma-separated, exactly as the admin console
# shows them under Users (for example you@example.com or yourname@github).
LH_TAILSCALE_ALLOWED_LOGINS=you@example.com
# https://<TS_HOSTNAME>.<your tailnet DNS name>, no trailing slash.
LH_PUBLIC_ORIGIN=https://learnharness.tail1234.ts.net
